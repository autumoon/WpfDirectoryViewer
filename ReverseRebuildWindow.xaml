<Window x:Class="WpfDirectoryViewer.ReverseRebuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="反向重建结构" Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        Icon="Images/app.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="输入TXT：" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="TxtInputPath" Width="400" Margin="0,0,8,0" AllowDrop="True"
                     PreviewDragEnter="TxtInputPath_PreviewDragEnter"
                     PreviewDragOver="TxtInputPath_PreviewDragOver"
                     PreviewDrop="TxtInputPath_PreviewDrop"
                     DragEnter="TxtInputPath_DragEnter" Drop="TxtInputPath_Drop"/>
            <Button Content="浏览..." Click="BrowseTxt_Click" Width="80"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="1">
            <TextBlock Text="输出目录：" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="TxtOutputDir" Width="400" Margin="0,0,8,0" AllowDrop="True"
                     PreviewDragEnter="TxtOutputDir_PreviewDragEnter"
                     PreviewDragOver="TxtOutputDir_PreviewDragOver"
                     PreviewDrop="TxtOutputDir_PreviewDrop"
                     DragEnter="TxtOutputDir_DragEnter" Drop="TxtOutputDir_Drop"/>
            <Button Content="浏览..." Click="BrowseOutput_Click" Width="80"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="2">
            <TextBlock Text="参考文件：" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="TxtReferenceFile" Width="400" Margin="0,0,8,0" AllowDrop="True"
                     PreviewDragEnter="TxtReferenceFile_PreviewDragEnter"
                     PreviewDragOver="TxtReferenceFile_PreviewDragOver"
                     PreviewDrop="TxtReferenceFile_PreviewDrop"
                     DragEnter="TxtReferenceFile_DragEnter" Drop="TxtReferenceFile_Drop"/>
            <Button Content="浏览..." Click="BrowseReferenceFile_Click" Width="80"/>
        </StackPanel>

        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                <CheckBox x:Name="ChkDryRun" Content="仅预览（Dry Run）" Margin="0,2,0,0"/>
                <TextBlock Text="  根目录名：" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="TxtRootName" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button Content="从TXT分析根目录名" Margin="16,0,0,0" Click="AnalyzeRootFromTxt_Click"/>
            </StackPanel>
            <TextBox x:Name="TxtLog" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right">
            <Button Content="开始创建" Width="100" Margin="0,8,0,0" Click="CreateStructure_Click"/>
            <Button Content="关闭" Width="80" Margin="8,8,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
