<Window x:Class="WpfDirectoryViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDirectoryViewer"
        mc:Ignorable="d"
        Title="目录结构查看器" Height="600" Width="800"
    Icon="Images/app.ico"
    MouseDoubleClick="Window_MouseDoubleClick">
    <Grid Margin="10">
        <Grid.Resources>
            <!-- 文件夹图标 -->
            <DrawingImage x:Key="FolderIcon">
                <DrawingImage.Drawing>
                    <GeometryDrawing Brush="#FFC8A064" Geometry="M2,20 L2,8 L8,2 L16,2 L22,8 L22,20 Z M24,10 L24,22 L2,22 L2,24 L24,24 L24,10 Z"/>
                </DrawingImage.Drawing>
            </DrawingImage>
            <!-- 文件图标 -->
            <DrawingImage x:Key="FileIcon">
                <DrawingImage.Drawing>
                    <GeometryDrawing Brush="#FFB8D0E9" Geometry="M2,16 L2,4 L6,4 L6,6 L18,6 L18,18 L6,18 L6,20 L22,20 L22,4 L18,4 L18,2 L4,2 L4,18 L16,18 L16,16 Z"/>
                </DrawingImage.Drawing>
            </DrawingImage>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="当前目录: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Name="CurrentPathTextBlock" Text="未选择目录" VerticalAlignment="Center" Width="400" AllowDrop="True" DragEnter="CurrentPathTextBlock_DragEnter" Drop="CurrentPathTextBlock_Drop" Background="#F0F0F0" Padding="5" Cursor="IBeam"/>
                <Button Name="BrowseButton" Content="浏览..." Click="BrowseButton_Click" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="输出目录: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Name="OutputPathTextBlock" Text="未设置输出目录" VerticalAlignment="Center" Width="400" AllowDrop="True" DragEnter="OutputPathTextBlock_DragEnter" Drop="OutputPathTextBlock_Drop" Background="#F0F0F0" Padding="5" Cursor="IBeam"/>
                <Button Name="OutputBrowseButton" Content="浏览..." Click="OutputBrowseButton_Click" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel>
                <!-- 输出形式选项行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="输出形式：" VerticalAlignment="Center" Margin="0,0,10,0" Width="70"/>
                    <RadioButton Name="TreeFormatRadioButton" Content="树形结构" GroupName="TxtOutputFormat" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton Name="PathListFormatRadioButton" Content="完整路径" GroupName="TxtOutputFormat" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>
                <!-- 输出内容选项行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="输出内容：" VerticalAlignment="Center" Margin="0,0,10,0" Width="70"/>
                    <CheckBox Name="ShowFileSizeCheckBox" Content="显示文件大小" IsChecked="True" Checked="ShowFileSizeCheckBox_Checked" Unchecked="ShowFileSizeCheckBox_Checked" Margin="0,0,10,0"/>
                    <CheckBox Name="ShowLastModifiedCheckBox" Content="显示修改时间" IsChecked="True" Checked="ShowLastModifiedCheckBox_Checked" Unchecked="ShowLastModifiedCheckBox_Checked" Margin="0,0,10,0"/>
                    <Separator Width="20"/>
                    <Button Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" Margin="5,0,0,0"/>
                    <Button Name="ExportButton" Content="导出" Click="ExportButton_Click" Margin="5,0,0,0"/>
                </StackPanel>
                <!-- 输出格式选项行 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输出格式：" VerticalAlignment="Center" Margin="0,0,10,0" Width="70"/>
                    <CheckBox Name="ExportTxtCheckBox" Content="输出TXT" IsChecked="True" Checked="ExportFormatCheckBox_Checked" Unchecked="ExportFormatCheckBox_Checked" Margin="0,0,10,0"/>
                    <CheckBox Name="ExportMdCheckBox" Content="输出MD" IsChecked="True" Checked="ExportFormatCheckBox_Checked" Unchecked="ExportFormatCheckBox_Checked" Margin="0,0,10,0"/>
                    <CheckBox Name="ExportHtmlCheckBox" Content="输出HTML" IsChecked="True" Checked="ExportFormatCheckBox_Checked" Unchecked="ExportFormatCheckBox_Checked" Margin="0,0,10,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        
        <TreeView Name="DirectoryTreeView" Grid.Row="1" Width="Auto" Height="Auto">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Name="ItemImage" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter TargetName="ItemImage" Property="Source" Value="{StaticResource FolderIcon}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                            <Setter TargetName="ItemImage" Property="Source" Value="{StaticResource FileIcon}"/>
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Window>
